# Required
DISCORD_TOKEN=
MONGODB_URL=mongodb://localhost:27017
MONGODB_NAME=vocard

# Lavalink (one node). NODES_JSON takes precedence when configuring multiple nodes.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_IDENTIFIER=DEFAULT

# Optional Discord and bot settings
# DISCORD_CLIENT_ID=
# BOT_PREFIX=?
# BOT_ACCESS_USERS=
# EMBED_COLOR=0xb3b3b3
# DEFAULT_MAX_QUEUE=1000
# DEFAULT_SEARCH_PLATFORM=youtube
# LYRICS_PLATFORM=lrclib
# GENIUS_TOKEN=
# SYNC_COMMANDS_ON_STARTUP=true

# Optional dashboard IPC
# IPC_ENABLED=false
# IPC_HOST=127.0.0.1
# IPC_PORT=8000
# IPC_PASSWORD=
# IPC_SECURE=false

# Optional advanced overrides. Each value must be valid one-line JSON.
# NODES_JSON={"DEFAULT":{"host":"localhost","port":2333,"password":"youshallnotpass","secure":false,"identifier":"DEFAULT"}}
# ACTIVITY_JSON=[{"type":"listening","name":"/help","status":"online"}]
# LOGGING_JSON={"file":{"path":"./logs","enable":true},"max_history":30}
# IPC_CLIENT_JSON={"host":"127.0.0.1","port":8000,"password":"","secure":false,"enable":false}
# PLAYLIST_SETTINGS_JSON={"max_playlists":5,"max_tracks_per_playlist":500,"default_playlist_name":"Favourite"}
# TIMER_SETTINGS_JSON={"bot_activity_update":600,"inactive_player_cleanup":600,"cache_cleanup":43200}
# SOURCES_SETTINGS_JSON={"others":{"emoji":"🔗","color":"0xb3b3b3"}}
# COOLDOWNS_JSON={}
# ALIASES_JSON={}
# DEFAULT_CONTROLLER_JSON={"embeds":{"inactive":{"description":"Waiting for requests"}}}

# Optional legacy/advanced JSON override file (relative paths use the project root).
# SETTINGS_FILE=settings.json
